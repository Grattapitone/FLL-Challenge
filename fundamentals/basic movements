def cpysign(var):
    return 1 if var > 0 else (-1 if var < 0 else 0)
def clamp(var, minv, maxv):
    return max(min(var, maxv), minv)

class Pid:
    def __init__(self, proportional: float, integral: float, derivative: float):
        self.__proportional_constant = proportional
        self.__integral_constant = integral
        self.__derivative_constant = derivative
        self.__last_time = 0.0
        self.__last_error = 0.0
        self.__integral_error_counter = 0.0
        self.__i = 0
        linegraph.clear_all()

    def calculate(self, target: float, measurement: float) -> float:
        # linegraph.plot(color.BLACK, self.__i, target)
        # linegraph.plot(color.MAGENTA, self.__i, measurement)
        delta_time = (time.ticks_ms() - self.__last_time)/1000.0 if self.__last_time else 0.0
        error = (target - measurement) * delta_time
        #proportional
        p = self.__proportional_constant * error
        #integral
        self.__integral_error_counter += error
        i = self.__integral_constant * self.__integral_error_counter
        #derivative
        d = self.__derivative_constant * (error - self.__last_error) if delta_time else 0.0
        #new values to repeat
        self.__last_time = time.ticks_ms()
        self.__last_error = error
        # linegraph.plot(color.ORANGE, self.__i, error)
        # linegraph.plot(color.PURPLE, self.__i, p)
        # linegraph.plot(color.AZURE, self.__i, i)
        # linegraph.plot(color.BLUE, self.__i, d)
        # linegraph.plot(color.GREEN, self.__i, p+i+d)
        self.__i+=1
        return p + i + d

class Robot:
    def __init__(self, wheel_diameter: float, wheel_distance: float, pid: Pid, acceleration_distance: float, deceleration_distance: float,right_motor: int, left_motor: int):
        print("Initializing Robot instance...")
        self.__wheel_diameter = wheel_diameter
        self.__wheel_circumference = self.__wheel_diameter * math.pi
        self.__degrees_per_cm = 360 / self.__wheel_circumference
        self.__wheel_distance = wheel_distance
        self.__right_motor = right_motor
        self.__left_motor = left_motor
        self.__drive_motors = motor_pair.PAIR_1
        self.__pid = pid
        self.__acceleration_dg = acceleration_distance * self.__degrees_per_cm
        self.__deceleration_dg = deceleration_distance * self.__degrees_per_cm
        motor_pair.pair(self.__drive_motors, self.__left_motor, self.__right_motor)
        print ("...done")

    def move_straight(self, distance: int, max_speed: int = 600):
        linegraph.clear_all()
        # reset motor angle measurements
        motor.reset_relative_position(self.__right_motor,0)
        motor.reset_relative_position(self.__left_motor,0)
        # calulate target_speed and target_degrees
        target_dg = abs(distance) * self.__degrees_per_cm
        max_speed = abs(max_speed)
        # store the starting angle, reset speed
        start_angle = round(motion_sensor.tilt_angles()[0]/10)
        speed = 0.0
        # start the loop
        progress_dg = 0.0
        while progress_dg < target_dg:
            linegraph.plot(color.RED, progress_dg, round(speed * cpysign(distance)))
            # calculate the progress made since last iteration
            progress_dg = abs((motor.relative_position(self.__right_motor) - motor.relative_position(self.__left_motor)) / 2)
            # ac-/decelerate depending on the new progress
            if progress_dg < self.__acceleration_dg:
                speed = (progress_dg / self.__acceleration_dg) * (max_speed - 30.0) + 30.0
            elif progress_dg > (target_dg - self.__deceleration_dg) and progress_dg <= target_dg:
                speed = (target_dg - progress_dg) / self.__deceleration_dg * (max_speed - 30.0) + 30.0
            else:
                speed = max_speed
            # calculate the pid value (class Pid)
            pid_o = round(self.__pid.calculate(start_angle, motion_sensor.tilt_angles()[0]/10))
            # start moving with the velocity of speed, the direction of the pid depending on the moving direction
            motor_pair.move(self.__drive_motors, pid_o * -cpysign(distance), velocity = round(speed * cpysign(distance)))
        # stop moving and wait to update the motion sensor
        motor_pair.stop(self.__drive_motors)
        time.sleep_ms(5)


robot = Robot(8.5, 8.1, Pid(1, 0, 0), 10, 10, port.B, port.A)
robot.move_straight(200)
robot.move_straight(-200)

sys.exit(1)

