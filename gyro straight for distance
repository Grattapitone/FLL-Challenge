from hub import port, motion_sensor
import motor_pair, motor

Kp = 1.5
motor_pair.pair(motor_pair.PAIR_1, port.B, port.A)

def moveForDistance(distance, wheel_circumference, speed=300):
    degrees_per_centimeter = 360 / wheel_circumference
    degrees = distance * degrees_per_centimeter
    motor_pair.move_for_degrees(motor_pair.PAIR_1, round(degrees), round(motion_sensor.tilt_angles()[0]/10 * (100/ 180) * Kp), velocity = speed)

moveForDistance(100,27.5)
