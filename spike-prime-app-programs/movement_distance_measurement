from hub import motion_sensor, port
import motor_pair, motor, sys, time, math, color
from app import linegraph

#CALIBRATING ACCELERATION
print("Donut touch the robot or he will his kill")

acceleration_offset_right = 0            #robot offset of the acceleration perpendicular to the motordriving direction
acceleration_offset_forward = 0          #robot offset of the acceleration in motordriving direction
measurement_sum_right = 0                #sum of acceleration measurements for the right direction
measurement_sum_forward = 0              #sum of acceleration measurements for the forward direction
for _ in range(100):
    measurement_sum_right += motion_sensor.acceleration(False)[1]
    measurement_sum_forward += motion_sensor.acceleration(False)[0]
    time.sleep_ms(2)
acceleration_offset_right = measurement_sum_right / 100
acceleration_offset_forward = measurement_sum_forward / 100
#END CALIBRATING

current_speed_forward = 0
current_speed_right = 0
current_acc_forward = 0
current_acc_right = 0

wheel_circumference = 27.5
left_motor = port.A
right_motor = port.B
blue_outboard = True        #if the blue disks on the driving motors are outboard, write True; if the blue disks are inboard, write False

if blue_outboard == True:
    direction = -1
else:
    direction = 1

#drive_motors = motor_pair.PAIR_1
#motor_pair.pair(drive_motors, right_motor, left_motor)
degrees_per_centimeter = 360 / wheel_circumference
last_time = 0

Kp = 1        # Proportional constant

linegraph.clear_all()
i = 0
def get_data():
    acc_forward = motion_sensor.acceleration(False)[0] - acceleration_offset_forward
    acc_right = motion_sensor.acceleration(False)[1] - acceleration_offset_right
    return acc_right, acc_forward
def calculate_data(current_acc_right, current_acc_forward):
    global last_time
    cur_time = time.time_ns()
    print(cur_time)
    time_diff = cur_time - last_time
    last_time = cur_time
    current_speed_forward = time_diff * current_acc_forward * 1000
    return current_acc_right, current_acc_forward, current_speed_right, current_speed_forward, time_diff

def plot_data(acc_right, acc_forward, speed_right, speed_forward, time_diff):
    global i
    linegraph.plot(color.RED, i, acc_forward)
    linegraph.plot(color.BLUE, i, acc_right)
    linegraph.plot(color.MAGENTA, i, speed_forward)
    linegraph.plot(color.AZURE, i, speed_right)
    i += time_diff * 1000

def moveForDistance(distance, speed=300):
    global i
    motor.reset_relative_position(left_motor,0)
    heading = motion_sensor.tilt_angles()[0]            # Heading at the Beginning
    degrees = distance * degrees_per_centimeter * direction        # total degrees the motors have to turn
    if degrees > 0:                                # basically "if you want the robot to move forward, then"
        while motor.relative_position(left_motor) < degrees:
            motor_pair.move(drive_motors, round((motion_sensor.tilt_angles()[0] - heading) / 10 * (100 / 180) * Kp), velocity = speed)
            plot_data(*calculate_data(*get_data()))
    else:
        while motor.relative_position(left_motor) > degrees:
            motor_pair.move(drive_motors, round((heading - motion_sensor.tilt_angles()[0]) / 10 * (100 / 180) * Kp), velocity = -speed)
            plot_data(*calculate_data(*get_data()))

    motor_pair.stop(0)
    for _ in range(10):
        plot_data(*calculate_data(*get_data()))
        time.sleep_ms(1)

#moveForDistance(100)
while True:
    plot_data(*calculate_data(*get_data()))

sys.exit()
